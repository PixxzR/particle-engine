---
// AmanaCosmos.astro
// Ambient particle field — drop this in src/components/, then add
// <AmanaCosmos /> to any page (typically Layout.astro or index.astro)
//
// Behavior:
// - Fixed full-viewport canvas behind page content (z-index: -1)
// - Pointer-events none (never interferes with site UX)
// - Ambient flow: 2 nebulae (violet + pink) + 30 streams + bright stars
// - Scroll-driven parallax + density modulation
// - Honors prefers-reduced-motion (renders static frame)
//
// Performance: 6000 particles (vs 20K in the prototype) for web perf.
// Tested target: 60fps on mid-range mobile.
---

<canvas id="amana-cosmos-canvas" aria-hidden="true"></canvas>

<style>
  #amana-cosmos-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    opacity: 0.65;
    mix-blend-mode: screen;
  }

  @media (prefers-reduced-motion: reduce) {
    #amana-cosmos-canvas {
      opacity: 0.35;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('amana-cosmos-canvas') as HTMLCanvasElement;
  if (!canvas) {
    console.warn('[AmanaCosmos] canvas not found');
  } else {
    initCosmos(canvas);
  }

  function initCosmos(canvas: HTMLCanvasElement) {
    const PARTICLE_COUNT = 6000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 200);
    camera.position.set(0, 0, 28);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setClearColor(0x000000, 0);

    // Particle system
    const positions = new Float32Array(PARTICLE_COUNT * 3);
    const colors = new Float32Array(PARTICLE_COUNT * 3);
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
      size: 0.12,
      vertexColors: true,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      sizeAttenuation: true,
      depthWrite: false,
    });

    const points = new THREE.Points(geometry, material);
    scene.add(points);

    // Scroll progress (0 at top, 1 at bottom)
    let scrollProg = 0;
    function updateScroll() {
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      scrollProg = Math.min(1, Math.max(0, window.scrollY / max));
    }
    updateScroll();
    window.addEventListener('scroll', updateScroll, { passive: true });

    // Resize
    function onResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }
    window.addEventListener('resize', onResize);

    // Pre-compute deterministic per-particle randomness
    const rnd = new Float32Array(PARTICLE_COUNT * 4);
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      for (let s = 0; s < 4; s++) {
        const x = Math.sin(i * 127.1 + s * 311.7) * 43758.5453;
        let v = x - Math.floor(x);
        if (v < 0) v += 1;
        rnd[i * 4 + s] = v;
      }
    }

    const colorObj = new THREE.Color();
    let elapsed = 0;
    let lastTime = performance.now();

    function frame(now: number) {
      const dt = Math.min(0.05, (now - lastTime) / 1000);
      lastTime = now;
      if (!reduceMotion) elapsed += dt;

      const time = elapsed;
      const t = time * 0.07;

      const posArr = positions;
      const colArr = colors;

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const r1 = rnd[i * 4];
        const r2 = rnd[i * 4 + 1];
        const r3 = rnd[i * 4 + 2];
        const r4 = rnd[i * 4 + 3];

        let role = 0;
        if (r4 > 0.95) role = 2;
        else if (r4 > 0.6) role = 1;

        let px = 0, py = 0, pz = 0;
        let h = 0.85, sat = 0.6, lum = 0.4;

        if (role === 2) {
          // Bright star
          px = (r1 - 0.5) * 30;
          py = (r2 - 0.5) * 38;
          pz = (r3 - 0.5) * 16;
          px += Math.sin(time * 0.4 + i * 0.3) * 0.3;
          py += Math.cos(time * 0.35 + i * 0.4) * 0.3;

          const twinkle = 0.5 + 0.5 * Math.sin(time * 1.4 + i * 0.7);
          const distTL = (px + 7) ** 2 + (py - 8) ** 2;
          const distBR = (px - 6) ** 2 + (py + 10) ** 2;
          h = distTL < distBR ? 0.78 + r3 * 0.06 : 0.9 + r3 * 0.05;
          sat = 0.45 + r2 * 0.25;
          lum = 0.6 + twinkle * 0.3;

        } else if (role === 1) {
          // Current stream
          const streamId = Math.floor(r1 * 30);
          const streamSeed = streamId * 0.137;
          const sx0 = Math.sin(streamSeed * 7.3) * 14;
          const sy0 = Math.cos(streamSeed * 4.1) * 18;
          const sx1 = Math.sin(streamSeed * 9.7 + 2) * 12;
          const sy1 = Math.cos(streamSeed * 5.3 + 1) * 16;

          const sParam = (r2 + time * 0.04) % 1;
          const sV = 1 - sParam;

          px = sV * sx0 + sParam * sx1 + Math.sin(sParam * Math.PI * 2 + streamSeed * 6) * 3;
          py = sV * sy0 + sParam * sy1 + Math.cos(sParam * Math.PI * 2 + streamSeed * 4) * 2.5;
          pz = (r3 - 0.5) * 8 + Math.sin(sParam * Math.PI + streamSeed * 3) * 2;
          px += (r4 - 0.5) * 0.4;
          py += (r1 - 0.5) * 0.3;

          h = 0.78 + sParam * 0.14;
          sat = 0.6 + r3 * 0.15;
          lum = 0.4 + Math.sin(sParam * Math.PI) * 0.18 + r1 * 0.06;

        } else {
          // Dust orbit around one of two nebula centers
          const center = r1 < 0.5 ? 0 : 1;
          const cx = center === 0 ? -7 : 6;
          const cy = center === 0 ? 8 : -10;
          const cz = center === 0 ? -2 : 3;

          const localR = Math.pow(r2, 1.4) * 16;
          const localA = r3 * Math.PI * 2;
          const localPhi = (r4 - 0.5) * Math.PI;

          px = cx + Math.cos(localA) * Math.cos(localPhi) * localR;
          py = cy + Math.sin(localPhi) * localR * 0.85;
          pz = cz + Math.sin(localA) * Math.cos(localPhi) * localR * 0.6;

          px += Math.sin(time * 0.25 + i * 0.02) * 0.6;
          py += Math.cos(time * 0.22 + i * 0.03) * 0.4;
          pz += Math.sin(time * 0.18 + i * 0.04) * 0.5;

          h = center === 0 ? 0.78 + r2 * 0.06 : 0.9 + r2 * 0.05;
          sat = 0.55 + r3 * 0.2;
          lum = Math.max(0.12, 0.35 - localR / 50 + r1 * 0.12);
        }

        // Scroll parallax
        py += -(scrollProg - 0.5) * 4;

        posArr[i * 3] = px;
        posArr[i * 3 + 1] = py;
        posArr[i * 3 + 2] = pz;

        colorObj.setHSL(h, sat, lum);
        colArr[i * 3] = colorObj.r;
        colArr[i * 3 + 1] = colorObj.g;
        colArr[i * 3 + 2] = colorObj.b;
      }

      geometry.attributes.position.needsUpdate = true;
      geometry.attributes.color.needsUpdate = true;

      renderer.render(scene, camera);
      requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }
</script>
